{
  "viewport": {
    "width": 1280,
    "height": 900
  },
  "runtime_errors": [],
  "error": null,
  "states": [
    {
      "name": "initial",
      "action": "true",
      "buttons": null,
      "result": {
        "result": {
          "type": "boolean",
          "value": true
        }
      }
    },
    {
      "name": "next_step",
      "action": "(()=>{const e=[...document.querySelectorAll('button')].find(e=>/下一|继续|next|开始/i.test(e.innerText)&&!e.disabled);if(e){e.click();return {action:'click',label:e.innerText}}return {skipped:'no matching visible step control'}})()",
      "buttons": null,
      "result": {
        "result": {
          "type": "object",
          "value": {
            "skipped": "no matching visible step control"
          }
        }
      }
    },
    {
      "name": "slider_mid",
      "action": "(()=>{const e=[...document.querySelectorAll('input[type=range]')].find(e=>e.getClientRects().length);if(e){e.value=(Number(e.min||0)+Number(e.max||100))/2;e.dispatchEvent(new Event('input',{bubbles:true}));e.dispatchEvent(new Event('change',{bubbles:true}));return {action:'range',value:e.value}}return {skipped:'no visible slider'}})()",
      "buttons": null,
      "result": {
        "result": {
          "type": "object",
          "value": {
            "action": "range",
            "value": "1"
          }
        }
      }
    },
    {
      "name": "slider_high",
      "action": "(()=>{const e=[...document.querySelectorAll('input[type=range]')].find(e=>e.getClientRects().length);if(e){e.value=e.max||100;e.dispatchEvent(new Event('input',{bubbles:true}));e.dispatchEvent(new Event('change',{bubbles:true}));return {action:'range',value:e.value}}return {skipped:'no visible slider'}})()",
      "buttons": null,
      "result": {
        "result": {
          "type": "object",
          "value": {
            "action": "range",
            "value": "1.8"
          }
        }
      }
    }
  ]
}

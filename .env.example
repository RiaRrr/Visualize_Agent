# Copy to .env. Leave unused providers empty. Never commit real keys.
# Viewing the included benchmark requires no API key or .env.
VISUALIZE_DATA_DIR=data_local
VISUALIZE_GENERATOR_MODEL=deepseek-v4-1-flash-261017
VISUALIZE_REVIEWER_MODEL=deepseek-v4-1-flash-261017
VISUALIZE_MODEL_TIMEOUT_SECONDS=900

# DeepSeek pilot: provider=codex, Chat Completions gateway.
# This is the gateway model ID used in the experiment, not an availability guarantee.
VISUALIZE_CODEX_BASE_URL=https://llm-gateway.edumind.ai/v1
VISUALIZE_CODEX_KEY=
VISUALIZE_CODEX_VERIFY_TLS=1
VISUALIZE_DEEPSEEK_THINKING=enabled

# Independent GPT judge: provider=openai, Responses-compatible gateway.
# Supply a gateway/account that actually offers the configured judge model.
VISUALIZE_OPENAI_BASE_URL=https://your-responses-gateway.example/v1
VISUALIZE_OPENAI_KEY=

# Optional second key on the Chat Completions gateway (OCR/Qwen experiments).
VISUALIZE_EDUMIND_ALT_KEY=
